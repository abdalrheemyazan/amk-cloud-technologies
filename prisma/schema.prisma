generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT_AGENT
  CLOUD_ENGINEER
  TEAM_LEADER
  ADMINISTRATOR
  TECHNICIAN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum SupportTransferStatus {
  COMPLETED
  CANCELLED
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  password         String
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  companyName      String?
  phone            String?
  requestedService String?
  shortMessage     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Custom user settings fields
  preferredLanguage  String? @default("he")
  preferredTheme     String? @default("light")
  emailNotifications Boolean @default(true)
  monthlyReport      Boolean @default(true)

  // Customer portal: company details (customer-facing, separate from support-agent fields below)
  companyIdNumber  String?
  companyRole      String?
  companyAddress   String?
  companyPhone     String?
  technicalContact String?
  technicalEmail   String?
  businessField    String?
  employeeCount    String?
  serviceNotes     String? @db.Text

  // Customer portal: notification preferences
  notifyRequestUpdates    Boolean @default(true)
  notifyMaintenanceAlerts Boolean @default(true)
  notifyDocumentUpdates   Boolean @default(false)

  // Personal support-agent profile. Email and role remain security-owned fields.
  displayName               String?
  profileImageUrl           String?
  department                String?
  supportSpecialty          String?
  supportLanguages          String[]       @default([])
  openingMessageTemplate    String?        @db.Text
  detailsRequestTemplate    String?        @db.Text
  waitingMessageTemplate    String?        @db.Text
  closingMessageTemplate    String?        @db.Text
  maxActiveChats            Int            @default(3)
  maxLiveChats              Int            @default(1)
  defaultAvailabilityStatus PresenceStatus @default(AVAILABLE)
  autoAwayMinutes           Int?           @default(30)
  newRequestNotifications   Boolean        @default(true)

  tickets         Ticket[]           @relation("UserTickets")
  assignedTickets Ticket[]           @relation("AgentTickets")
  articles        KnowledgeArticle[]

  // Prepared Responses relations
  ownedPreparedResponses   PreparedResponse[] @relation("PreparedResponseOwner")
  createdPreparedResponses PreparedResponse[] @relation("PreparedResponseCreator")
  updatedPreparedResponses PreparedResponse[] @relation("PreparedResponseUpdater")

  // Live Technical Support relations
  customerSessions         SupportSession[]         @relation("SessionCustomer")
  technicianSessions       SupportSession[]         @relation("SessionTechnician")
  authoredNotes            TechnicianNote[]         @relation("TechnicianAuthoredNotes")
  sentInternalMessages     InternalSupportMessage[] @relation("InternalMessageSender")
  receivedInternalMessages InternalSupportMessage[] @relation("InternalMessageRecipient")
  sentSupportTransfers     SupportTransfer[]        @relation("SupportTransferSender")
  receivedSupportTransfers SupportTransfer[]        @relation("SupportTransferRecipient")
  supportActivities        SupportActivity[]        @relation("SupportActivityActor")
  uploadedSupportFiles     SupportAttachment[]      @relation("SupportAttachmentUploader")
  clearedInternalChats     InternalChatClearState[] @relation("InternalChatClearViewer")
  clearedByPeers           InternalChatClearState[] @relation("InternalChatClearPeer")

  // NextAuth standard relations
  accounts Account[]
  sessions Session[]

  // Core & Audit Logging relations
  ticketMessages TicketMessage[]
  auditLogs      AuditLog[]
  presence       TechnicianPresence?
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String
  user        User           @relation("UserTickets", fields: [userId], references: [id])
  agentId     String?
  agent       User?          @relation("AgentTickets", fields: [agentId], references: [id])

  // Soft cancellation fields
  cancellationReason String?
  cancelledAt        DateTime?

  // Relations
  messages TicketMessage[]
}

model KnowledgeArticle {
  id                    String   @id @default(cuid())
  slug                  String   @unique @default(cuid())
  title                 String
  content               String   @db.Text
  category              String
  tags                  String[]
  authorId              String
  author                User     @relation(fields: [authorId], references: [id])
  audience              String   @default("CUSTOMER")
  severity              String   @default("LOW")
  symptoms              String?  @db.Text
  diagnosisSteps        String?  @db.Text
  resolutionSteps       String?  @db.Text
  escalationCriteria    String?  @db.Text
  customerReplyTemplate String?  @db.Text
  internalNotes         String?  @db.Text
  isPublished           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// A knowledge source for semantic (embedding-based) search: either an admin-uploaded
// file (sourceType "UPLOAD") or a mirror of a KnowledgeArticle row kept in sync so
// existing article content is searchable the same way (sourceType "ARTICLE").
model KnowledgeDocument {
  id              String    @id @default(cuid())
  title           String
  fileName        String
  storagePath     String?
  mimeType        String
  sizeBytes       Int
  audience        String    @default("CUSTOMER_VISIBLE") // CUSTOMER_VISIBLE, SUPPORT_INTERNAL, TECHNICIAN_ONLY
  category        String?
  sourceType      String    @default("UPLOAD") // UPLOAD, ARTICLE
  sourceArticleId String? // set when sourceType = ARTICLE; app-level reference only, not a DB FK
  status          String    @default("UPLOADED") // UPLOADED, PROCESSING, READY, FAILED
  errorMessage    String?   @db.Text
  chunkCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  processedAt     DateTime?

  chunks KnowledgeChunk[]

  @@index([status])
  @@index([sourceArticleId])
}

model KnowledgeChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int?
  title      String?
  category   String?
  audience   String                      @default("CUSTOMER_VISIBLE")
  content    String                      @db.Text
  // pgvector column — managed outside Prisma's type system; see prisma/enable-pgvector.ts
  // for the extension + column DDL and src/lib/knowledge/vector-search.ts for raw SQL access.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  @@index([documentId])
  @@index([audience])
}

model MonitoringAlert {
  id        String   @id @default(cuid())
  source    String
  severity  String
  message   String
  timestamp DateTime @default(now())
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SupportSession {
  id                String                    @id @default(cuid())
  status            String                    @default("PENDING") // PENDING, ACTIVE, COMPLETED, CLOSED, REJECTED, EXPIRED
  customerId        String
  customer          User                      @relation("SessionCustomer", fields: [customerId], references: [id])
  technicianId      String?
  technician        User?                     @relation("SessionTechnician", fields: [technicianId], references: [id])
  category          String?
  subject           String?
  summary           String?
  // Auto-classified on the server at submission from the request content/impact
  // (never from customer urgency wording). Nullable so existing rows stay valid;
  // code treats missing as MEDIUM. Staff may override; reason is internal-only.
  priority          SupportPriority?
  priorityReason    String?                   @db.Text
  acceptedAt        DateTime?
  closedAt          DateTime?
  expiresAt         DateTime?
  // True only while the session has never been escalated to a human (still AI_CHAT,
  // or closed by the customer without ever transferring). Flipped to false the moment
  // it's handed off — that's the signal that lets us hard-delete safely vs. soft-delete
  // to preserve the support/audit record.
  isAiOnly          Boolean                   @default(false)
  customerDeletedAt DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  messages          SessionMessage[]
  remotes           RemoteConnectionRequest[]
  notes             TechnicianNote[]
  internalMessages  InternalSupportMessage[]
  transfers         SupportTransfer[]
  publicActivities  SupportActivity[]
  attachments       SupportAttachment[]

  @@index([customerId, status])
  @@index([technicianId, status])
  @@index([status, createdAt])
  @@index([priority])
}

model InternalSupportMessage {
  id          String              @id @default(cuid())
  senderId    String
  sender      User                @relation("InternalMessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User                @relation("InternalMessageRecipient", fields: [recipientId], references: [id])
  sessionId   String?
  session     SupportSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content     String              @db.Text
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([sessionId, createdAt])
}

model SupportTransfer {
  id          String                @id @default(cuid())
  sessionId   String
  session     SupportSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromAgentId String
  fromAgent   User                  @relation("SupportTransferSender", fields: [fromAgentId], references: [id])
  toAgentId   String
  toAgent     User                  @relation("SupportTransferRecipient", fields: [toAgentId], references: [id])
  note        String?               @db.Text
  status      SupportTransferStatus @default(COMPLETED)
  createdAt   DateTime              @default(now())

  @@index([sessionId, createdAt])
  @@index([toAgentId, createdAt])
}

model SupportActivity {
  id        String         @id @default(cuid())
  sessionId String
  session   SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation("SupportActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  message   String
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model SessionMessage {
  id          String              @id @default(cuid())
  sessionId   String
  session     SupportSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId    String
  senderRole  Role
  message     String
  type        String              @default("TEXT") // TEXT, SYSTEM, LOG, SCREENSHOT
  attachments Json? // legacy inline attachments retained for backward compatibility
  createdAt   DateTime            @default(now())
  deletedAt   DateTime?
  deletedById String?
  files       SupportAttachment[]

  @@index([sessionId, createdAt])
  @@index([sessionId, deletedAt])
}

model SupportAttachment {
  id                String                  @id @default(cuid())
  sessionId         String?
  session           SupportSession?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionMessageId  String?
  sessionMessage    SessionMessage?         @relation(fields: [sessionMessageId], references: [id], onDelete: Cascade)
  internalMessageId String?
  internalMessage   InternalSupportMessage? @relation(fields: [internalMessageId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User                    @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  fileName          String
  fileType          String
  fileSize          Int
  storageProvider   String                  @default("DATABASE")
  storagePath       String
  publicUrl         String?
  inlineData        String?                 @db.Text
  createdAt         DateTime                @default(now())
  expiresAt         DateTime

  @@index([sessionId, createdAt])
  @@index([sessionMessageId])
  @@index([internalMessageId])
  @@index([expiresAt])
}

model InternalChatClearState {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("InternalChatClearViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  peerId    String
  peer      User     @relation("InternalChatClearPeer", fields: [peerId], references: [id], onDelete: Cascade)
  clearedAt DateTime @default(now())

  @@unique([viewerId, peerId])
  @@index([clearedAt])
}

model RemoteConnectionRequest {
  id             String         @id @default(cuid())
  sessionId      String
  session        SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status         String         @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  connectionType String         @default("ANYDESK") // TEAMVIEWER, ANYDESK
  connectionId   String?
  password       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model TechnicianNote {
  id           String          @id @default(cuid())
  sessionId    String?
  session      SupportSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User            @relation("TechnicianAuthoredNotes", fields: [technicianId], references: [id])
  content      String
  isPrivate    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([sessionId, createdAt])
  @@index([technicianId, createdAt])
}

// NextAuth core models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Ticket messaging model
model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

// Service catalog model
model Service {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, MAINTENANCE, OFFLINE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// System logging model
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

enum PresenceStatus {
  ONLINE
  OFFLINE
  BUSY
  IN_TICKET
  IN_REMOTE_SESSION
  AVAILABLE
}

model TechnicianPresence {
  id                      String         @id @default(cuid())
  technicianId            String         @unique
  technician              User           @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  status                  PresenceStatus @default(OFFLINE)
  mode                    String         @default("AUTO") // AUTO | MANUAL — whether `status` is workflow-driven or agent-pinned
  activeChatsCount        Int            @default(0)
  currentTicketId         String?
  currentSupportSessionId String?
  lastSeenAt              DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

enum ResponseScope {
  PERSONAL
  TEAM
}

enum PreparedResponseCategory {
  GREETING
  REQUEST_INFORMATION
  WAITING
  FOLLOW_UP
  RESOLUTION
  CLOSING
  OTHER
}

model PreparedResponse {
  id          String                   @id @default(cuid())
  ownerId     String?
  owner       User?                    @relation("PreparedResponseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  category    PreparedResponseCategory @default(OTHER)
  content     String                   @db.Text
  scope       ResponseScope            @default(PERSONAL)
  isActive    Boolean                  @default(true)
  createdById String
  createdBy   User                     @relation("PreparedResponseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?                    @relation("PreparedResponseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([ownerId])
  @@index([scope, isActive])
  @@index([category])
}
